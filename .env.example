# Stripe (test mode for local / staging)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Stripe Price IDs for recurring products.
# If unset, Checkout creates price_data at $12 (Builder) / $39 (Team).
STRIPE_PRICE_BUILDER=price_...
STRIPE_PRICE_TEAM=price_...

# Optional: canonical site URL (used as Checkout origin fallback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
