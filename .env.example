# Stripe (test mode for local / Vercel Checkout — not needed for GitHub Pages)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Stripe Price IDs for recurring products.
# If unset, Checkout creates price_data at $12 (Builder) / $39 (Team).
STRIPE_PRICE_BUILDER=price_...
STRIPE_PRICE_TEAM=price_...

# Canonical site URL (Checkout origin fallback + robots/sitemap)
# Pages: https://maxmccutcheon59.github.io/watchwire-site
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Pages static export (set by npm run build:pages / CI — leave unset on Vercel)
# GITHUB_PAGES=true
# STATIC_EXPORT=true
# BASE_PATH=/watchwire-site
# NEXT_PUBLIC_BASE_PATH=/watchwire-site
# NEXT_PUBLIC_STATIC_EXPORT=true
